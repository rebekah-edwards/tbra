# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/data/
*.db
data/*.db
.turso-sync-incremental/

# generated logs / run output / scratch / reports — regenerable, never commit.
# scripts/_*.ts are throwaway one-off debug scratch (NOT real tooling).
scripts/*.log
scripts/*.out
scripts/enrichment-log-*.txt
scripts/_*
/reports/

# Claude Code harness session command log (local artifact)
.claude/command-log.txt

# native-ios: generated by xcodegen from project.yml — regenerate, don't commit
native-ios/Tbra.xcodeproj/
native-ios/Info.plist
native-ios/screenshot-*.png
native-ios/*.xcworkspace/
native-ios/DerivedData/
native-ios/build/
